{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZScan NFT registry",
  "type": "object",
  "required": ["collections"],
  "properties": {
    "$schema": { "type": "string" },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } }
  },
  "additionalProperties": false,
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" } },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["slug", "name", "description", "kind", "confidence", "sources"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$", "description": "URL key: lowercase letters, digits and dashes." },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 10, "maxLength": 400, "description": "Neutral and factual: what the collection is, not marketing." },
        "kind": { "enum": ["inscription", "marketplace"], "description": "inscription: items are Zcash inscriptions (ZRC-721 or launchpad mints). marketplace: items live in a marketplace's own records." },
        "website": { "type": "string", "pattern": "^https://" },
        "x": { "type": "string", "pattern": "^https://(x|twitter)\\.com/" },
        "discord": { "type": "string", "pattern": "^https://" },
        "telegram": { "type": "string", "pattern": "^https://" },
        "logo": { "type": "string", "pattern": "^(https|ipfs)://", "description": "Square image, HTTPS or ipfs://." },
        "supply": { "type": "integer", "minimum": 1 },
        "minted_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "mint_price_zec": { "type": "number", "minimum": 0 },
        "onchain": {
          "type": "object",
          "description": "What links the collection to the chain: its ZRC-721 name, or the address every launchpad mint paid.",
          "properties": {
            "zrc721": { "type": "string", "pattern": "^[A-Z0-9 _-]{1,32}$" },
            "drop": { "type": "string", "pattern": "^t1[1-9A-HJ-NP-Za-km-z]{33}$" }
          },
          "additionalProperties": false
        },
        "market": {
          "type": "object",
          "required": ["kind", "url"],
          "description": "A marketplace with an API ZScan supports: zemon, zilkroad, zeccat, zecpad.",
          "properties": { "kind": { "enum": ["zemon", "zilkroad", "zeccat", "zecpad"] }, "url": { "type": "string", "pattern": "^https://" }, "id": { "type": "string" } },
          "additionalProperties": false
        },
        "marketplaces": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "confidence": { "enum": ["verified", "likely"] },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }
      },
      "additionalProperties": false
    }
  }
}
